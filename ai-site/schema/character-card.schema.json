{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://game-intel.local/schema/character-card.schema.json",
  "title": "game-intel character guide card",
  "type": "object",
  "required": [
    "id",
    "name",
    "game"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "not": {
          "required": ["stub"],
          "properties": {
            "stub": { "const": true }
          }
        }
      },
      "then": {
        "required": ["sources", "as_of"],
        "properties": {
          "sources": {
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "as_of": {
            "type": "string",
            "minLength": 4,
            "description": "Asia/Shanghai date or month the card was verified, e.g. 2026-09"
          }
        }
      },
      "description": "Non-stub cards (stub absent or false) must cite sources and as_of."
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "description": "Canonical display name (usually ZH)"
    },
    "name_zh": {
      "type": "string"
    },
    "name_en": {
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nicknames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "game": {
      "type": "string"
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "skill_prio": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stigmata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "weapon": {
      "type": [
        "string",
        "null"
      ]
    },
    "teams": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      },
      "description": "Verified source URLs (GameKee / Prydwen / Bahamut). Required when stub is not true."
    },
    "stub": {
      "type": "boolean",
      "description": "true = placeholder; do not invent skills"
    },
    "note": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "minLength": 4,
      "description": "Required on non-stub cards. Asia/Shanghai date or month."
    },
    "verified": {
      "type": "string"
    },
    "gamekee_content_id": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "gamekee_entry_id": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "object",
      "description": "Human+AI conclusion line. Required on non-stub HW/NIKKE/BD2 cards at export. summary.stub true = thin evidence (no invented tier/pull). Omit on skill stubs.",
      "additionalProperties": true,
      "required": ["sources"],
      "properties": {
        "tier": {
          "type": "string",
          "description": "Verified strength line, e.g. GameKee T度. Do not invent."
        },
        "position": {
          "type": "string",
          "description": "Catalog class/element/rarity when no verified tier exists."
        },
        "pull": {
          "type": "string",
          "description": "Pull advice copied from a cited source. No invented numbers."
        },
        "skip": {
          "type": "string",
          "description": "What not to chase, only when a source says so."
        },
        "caveat": {
          "type": "string",
          "description": "Honest limit of the conclusion (missing tier list, no pull text)."
        },
        "stub": {
          "type": "boolean",
          "description": "true = conclusion incomplete; do not treat tier/pull as verified."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          },
          "description": "Verified source URLs for the conclusion bar"
        }
      }
    }
  }
}
