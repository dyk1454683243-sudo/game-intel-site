{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://game-intel.local/schema/claim.schema.json",
  "title": "game-intel sourced claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["statement", "sources"],
  "properties": {
    "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "claim": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Alias of statement" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "game_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "game": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "character_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "character": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "as_of": { "type": "string" },
    "submitter": { "type": "string", "maxLength": 80 }
  }
}
