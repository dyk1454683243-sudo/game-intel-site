{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://game-intel.local/schema/feed.schema.json",
  "title": "game-intel cross-platform feed",
  "type": "object",
  "required": ["meta", "items"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["as_of", "timezone"],
      "additionalProperties": true,
      "properties": {
        "as_of": { "type": "string" },
        "timezone": { "type": "string", "const": "Asia/Shanghai" },
        "generated_at": { "type": "string" },
        "source": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "game_id": { "type": ["string", "null"] },
          "platform": { "type": "string" },
          "published_at": { "type": ["string", "null"] },
          "source": { "type": "string" }
        }
      }
    }
  }
}
