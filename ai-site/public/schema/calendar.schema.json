{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://game-intel.local/schema/calendar.schema.json",
  "title": "game-intel calendar",
  "type": "object",
  "required": ["meta", "as_of", "count", "events"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["fixture", "generated_at", "timezone", "source"],
      "additionalProperties": true,
      "properties": {
        "fixture": { "type": "boolean" },
        "generated_at": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "const": "Asia/Shanghai" },
        "source": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "as_of": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "game",
          "name",
          "type",
          "title",
          "start",
          "end",
          "note",
          "url",
          "source",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "game": { "type": "string" },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["banner", "event", "maintenance", "collab", "login", "other"]
          },
          "title": { "type": "string" },
          "start": { "type": ["string", "null"] },
          "end": { "type": ["string", "null"] },
          "note": { "type": "string" },
          "url": { "type": "string" },
          "source": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "high"] },
          "precision": { "type": "string", "enum": ["month"] },
          "id": { "type": "string" }
        }
      }
    }
  }
}
