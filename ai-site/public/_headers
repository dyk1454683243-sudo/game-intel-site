/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type

/v1/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  X-API-Version: 1
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Headers: Content-Type, Authorization, X-API-Key, If-None-Match
  Access-Control-Expose-Headers: ETag, X-API-Version, Retry-After

/openapi.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  X-API-Version: 1
  Access-Control-Allow-Origin: *

/developers/*
  Cache-Control: public, max-age=3600

/schema/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/mcp/server-card
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# Static UI assets. /v1 JSON keeps the headers above and the worker's ETag path.
/ui/*
  Cache-Control: public, max-age=86400

/sketches/sketch.css
  Cache-Control: public, max-age=86400

/games/*
  Cache-Control: public, max-age=600

/guides/*
  Cache-Control: public, max-age=600

/en/*
  Cache-Control: public, max-age=600

/ja/*
  Cache-Control: public, max-age=600

/catalog/*
  Cache-Control: public, max-age=600

/watchlist/*
  Cache-Control: public, max-age=600

/game/*
  Cache-Control: public, max-age=600

/character/*
  Cache-Control: public, max-age=600

/me/*
  Cache-Control: public, max-age=600

/for-ai/*
  Cache-Control: public, max-age=600

/sketches/*
  Cache-Control: public, max-age=3600

/index.html
  Cache-Control: public, max-age=600

/404.html
  Cache-Control: public, max-age=300

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap-zh.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap-en.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap-ja.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
