const GK_QA_DEBT_RE = /还债|還債/;
/** GameKee water-post / Q&A title noise (no news signal). */
const GK_QA_BODY_RE =
  /mod疑问|mod問題|疑问|疑問|求助|求大佬|不生效|怎么弄|怎麼弄|目录不是|目錄不是/;
